# ===================================================
# VERO ACORDO & VOICE AI - CONFIGURAÇÕES DE AMBIENTE
# ===================================================

PORT=3001
NODE_ENV=production
APP_BASE_URL=https://veroacordo.grupoddm.ia.br

# Provedor padrão de discagem: 'dialddm' (Dialog DDM Voice AI)
DIALER_PROVIDER=dialddm

# ===================================================
# DIALOG DDM VOICE AI GATEWAY (MeuDiscador / Oktor)
# ===================================================
DIALDDM_BASE_URL=https://dialddm.grupoddm.ia.br/v1
DIALDDM_API_KEY=sua_chave_api_aqui
DIALDDM_DEFAULT_ASSISTANT_ID=12
DIALDDM_PHONE_NUMBER_ID=oktor_sip_500ch
DIALDDM_MAX_CONCURRENCY=20

# ===================================================
# PACING & CONCORRÊNCIA (20 Canais Livres)
# ===================================================
WORKER_DELAY_BETWEEN_CALLS_MS=1000
WORKER_CALL_BATCH_SIZE=20
MAX_CONCURRENT_CALLS=20

# ===================================================
# VERO ACORDO API (meuacordofacil)
# ===================================================
VERO_ACORDO_BASE_URL=https://vero2.meuacordofacil.com.br/api/cliente
VERO_ACORDO_USER=seu_usuario_aqui
VERO_ACORDO_PASS=sua_senha_aqui

# ===================================================
# SMART RCS / SMS GATEWAY
# ===================================================
SMART_RCS_API_KEY=3EE7BE3E-FE44-4EFA-B0DA-6D85D096BB63
SMART_RCS_API_URL=https://developer.smartrcs.com.br/api/Message/text
SMART_RCS_SENDER=rcs_grupoddm

# ===================================================
# SMTP CPANEL EMAIL
# ===================================================
SMTP_HOST=mail.grupoddm.ia.br
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=vero@grupoddm.ia.br
SMTP_PASS=sua_senha_aqui
SMTP_FROM_NAME="Vero Internet"
SMTP_FROM_EMAIL=vero@grupoddm.ia.br


